{
  "schema_version": 2,
  "diagram_type": "lifecycle",
  "meta": {
    "title": "Transfer recommendation lifecycle",
    "output": "docs/architecture/transfer-lifecycle.html",
    "quality_profile": "showcase"
  },
  "lanes": [
    { "id": "main", "label": "Recommendation" },
    { "id": "terminal", "label": "Outcome" }
  ],
  "states": [
    { "id": "recommended", "type": "start", "label": "Recommended", "sublabel": "daily job finds a gap", "lane": "main", "col": 0, "step": "01" },
    { "id": "pending", "type": "waiting", "label": "Pending", "sublabel": "waiting for a planner", "lane": "main", "col": 1, "step": "02", "tag": "only state that changes" },
    { "id": "approved", "type": "success", "label": "Approved", "sublabel": "planner said yes", "lane": "main", "col": 3, "step": "03" },
    { "id": "counted", "type": "active", "label": "Counted as stock", "sublabel": "arriving at the store", "lane": "main", "col": 4, "step": "04" },
    { "id": "rejected", "type": "failure", "label": "Rejected", "sublabel": "reason recorded", "lane": "terminal", "col": 1 },
    { "id": "withdrawn", "type": "neutral", "label": "Withdrawn", "sublabel": "no longer needed", "lane": "terminal", "col": 2 }
  ],
  "transitions": [
    { "from": "recommended", "to": "pending", "label": "saved" },
    { "from": "pending", "to": "approved", "label": "planner approves", "variant": "emphasis" },
    { "from": "approved", "to": "counted", "label": "next run" },
    { "from": "pending", "to": "rejected", "label": "planner rejects", "variant": "security", "route": "drop" },
    { "from": "pending", "to": "withdrawn", "label": "gap closed", "variant": "dashed" }
  ],
  "cards": [
    { "dot": "emerald", "title": "One way forward", "items": ["Only Pending can change; Approved and Rejected are final", "A second decision on the same transfer is reported, not applied"] },
    { "dot": "amber", "title": "Refreshed daily", "items": ["The daily job refreshes and removes Pending rows only", "Decided rows are never overwritten or deleted"] },
    { "dot": "cyan", "title": "No double recommending", "items": ["Approved moves count as arriving stock in the next run", "The same move is never pending twice"] }
  ]
}
