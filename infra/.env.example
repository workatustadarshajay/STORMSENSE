# Copy to backend/.env for local runs. Placeholders only: never commit real values.

# mock = sample data, nothing else needed. databricks = your workspace.
STORMSENSE_MODE=mock
# local allows a built-in dev identity. production requires the platform's sign-in.
STORMSENSE_ENVIRONMENT=local
STORMSENSE_DEV_USER_EMAIL=ava.planner@stormsense.test

# Only for STORMSENSE_MODE=databricks when running on your own machine.
# In a deployed Databricks App these are supplied by the platform, and there are no secrets to set.
DATABRICKS_WAREHOUSE_ID=
DATABRICKS_GENIE_SPACE_ID=
STORMSENSE_CATALOG=
STORMSENSE_SCHEMA=stormsense
STORMSENSE_DATABRICKS_PROFILE=stormsense
