{
  "datasets": [
    {
      "name": "kpi",
      "displayName": "Kpi",
      "query": "SELECT\n  (SELECT count(*) FROM workspace.stormsense.transfer_recommendations WHERE status = 'PENDING' AND urgency = 'URGENT') AS urgent,\n  (SELECT count(*) FROM workspace.stormsense.transfer_recommendations WHERE status = 'PENDING') AS pending,\n  (SELECT round(sum(sales_protected_usd)) FROM workspace.stormsense.transfer_recommendations WHERE status = 'PENDING') AS protected_usd,\n  (SELECT count(DISTINCT store_id) FROM workspace.stormsense.inventory_gaps WHERE status = 'SHORTAGE' AND as_of_date = (SELECT max(as_of_date) FROM workspace.stormsense.inventory_gaps)) AS stores_at_risk"
    },
    {
      "name": "units_by_product",
      "displayName": "Units by product",
      "query": "SELECT p.name AS product, round(sum(f.predicted_units)) AS units\nFROM workspace.stormsense.predictions f JOIN workspace.stormsense.products p ON p.product_id = f.product_id\nWHERE f.as_of_date = (SELECT max(as_of_date) FROM workspace.stormsense.predictions)\nGROUP BY p.name ORDER BY units DESC"
    },
    {
      "name": "short_by_store",
      "displayName": "Short by store",
      "query": "SELECT s.name AS store, round(sum(g.shortfall_units)) AS units_short\nFROM workspace.stormsense.inventory_gaps g JOIN workspace.stormsense.stores s ON s.store_id = g.store_id\nWHERE g.status = 'SHORTAGE' AND g.as_of_date = (SELECT max(as_of_date) FROM workspace.stormsense.inventory_gaps)\nGROUP BY s.name ORDER BY units_short DESC"
    },
    {
      "name": "pending_transfers",
      "displayName": "Pending transfers",
      "query": "SELECT s1.name AS from_store, s2.name AS to_store, p.name AS product, t.qty AS units,\n  t.urgency, round(t.sales_protected_usd) AS sales_protected_usd\nFROM workspace.stormsense.transfer_recommendations t\nJOIN workspace.stormsense.stores s1 ON s1.store_id = t.source_store_id\nJOIN workspace.stormsense.stores s2 ON s2.store_id = t.dest_store_id\nJOIN workspace.stormsense.products p ON p.product_id = t.product_id\nWHERE t.status = 'PENDING'\nORDER BY (t.urgency = 'URGENT') DESC, t.sales_protected_usd DESC"
    },
    {
      "name": "accuracy",
      "displayName": "Accuracy",
      "query": "SELECT model_version AS version, round(wape_model, 3) AS forecaster,\n  round(wape_same_as_last_week, 3) AS same_as_last_week, round(wape_trailing_28d_avg, 3) AS trailing_28_day_average,\n  CASE WHEN promoted THEN 'Champion' ELSE 'Not promoted' END AS status\nFROM workspace.stormsense.model_runs ORDER BY trained_at DESC"
    },
    {
      "name": "cost",
      "displayName": "Cost",
      "query": "SELECT usage_date, round(sum(dbus), 2) AS dbus\nFROM workspace.stormsense.cost_daily GROUP BY usage_date ORDER BY usage_date"
    }
  ],
